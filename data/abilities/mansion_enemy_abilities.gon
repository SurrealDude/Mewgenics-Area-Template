VictimMurderer {
    template targeted_status
	chain_ability VictimNearestSuspect

    graphics {
        animation none
        particle none
    }

    target {
        max_range 20
    }

    damage_instance {
        damage 0
        cant_miss true

        effects {
            CanApplyToInanimate {
                Doomed 99
            }
        }
    }
}
VictimNearestSuspect {
    template spell

    graphics {
        particle none
        animation none
        dont_visualize_ai true
    }
    
    target {
        target_mode random_closest_tile
        recalc_target_on_castpoint true
        min_range 1
        max_range 20
		min_aoe 0
		max_aoe 0
		multihit 99
        restrictions [must_have_living_character]
		range_considers_character_size true
    }

    damage_instance {
        damage 0
        cant_miss true

        effects {
			Conditional_HasStatus {
				status Tarred
			} Else {
				Tarred 99
			}
        }
        ai_base_score 999999
    }
}
PawPrintsAggro {
    template spell

    graphics {
        particle none
        animation scratch
        dont_visualize_ai true
    }
    
    target {
        target_mode none
        aoe_mode all
		//max_targets 1
        restrictions aoe_must_exist
        //aoe_restrictions must_have_aggro_target
		aoe_restrictions [must_have_living_character]
    }

    damage_instance {
        damage 0
		cant_miss true

        effects {
			Conditional_HasStatus {
				status Tarred
				CanApplyToInanimate {
					GetAggroTarget 1
				}
				Immobile 99
			}
        }
        ai_base_score 999999
    }
}
