LongLegReady {
    template melee_attack
    
    meta {
        name "EABILITY_LEGREADY_NAME"
        animate_name true
    }

    graphics {
        animation readyup
        dont_orient true
        dont_visualize_ai true
    }
	
	sounds {
        ontrigger Ani_Trampy_walk_Frame2
    }

    cost {
		cantrip true
        mana 0
		act_points 0
    }

    target {
        target_mode none
        aoe_mode standard
        min_aoe 1
        max_aoe 1
        aoe_restrictions [must_have_tag]
        target_requires_tag leg
    }

    damage_instance {
        type melee
        damage 0
		piercing true
		cant_miss true

        effects {
            ApplyToSource {
                FormChange Ready
            }
        }
		
        ai_base_score 999999
    }
}
LongLegStep {
    template jump_move

    graphics {
        full_jump_animation step
        full_jump_sync_frames 31
        full_jump_windup_frames 9
    }

    cost {
        move_points 1
    }
    
    target {
        min_range 0
        max_range mov
        restrictions [must_be_moveable]
    }

    damage_instance {
        damage 4+bonus_melee_damage
    }
	
    self_damage {
        effects {
            FormChange {
                form Alone
            }
        }
    }
}
LongLegRegroup {
    template jump_move

    graphics {
        full_jump_animation step
        full_jump_sync_frames 31
        full_jump_windup_frames 5
    }

    cost {
        move_points 1
    }
    
    target {
        min_range 0
        max_range mov
        restrictions [must_be_moveable must_be_adjacent_to_ally]
    }

    damage_instance {
        damage 4+bonus_melee_damage

        effects {
            IgnoreSelf 1
        }
    }
}
