VampireDagger {
    template melee_attack
	
	meta {
		name "EABILITY_BLEEDFORME_NAME"
	}

    damage_instance {
		damage 3+bonus_melee_damage
		effects {
			Bleed 1
			Conditional_Speculative { // make ai prefer non-bleeding units
				Conditional_HasStatus {
					status Bleed
					ApplyToSource {
						DieViolently 1
					}
				}
			}
		}
    }
}
VampireBite {
    template melee_attack
	
	graphics {
        animation bite
    }
	
	target {
		restrictions [must_have_living_character]
	}

    damage_instance {
        damage 3+bonus_melee_damage
        piercing true
		
        effects {
			Conditional_HasStatus {
				status Bleed
				Leech 2
				Conditional_Speculative { // make the ai think it instakills by sucking
					DieViolently 1
				} Else {
					RemoveStatusStacks {
						status Bleed
						stacks 1
					}
					Conditional_HasStatus {
						status Poison
						ApplyToSource {
							Poison 2
						}
						RemoveStatusStacks {
							status Poison
							stacks 1
						}
					}
				}
			} Else {
				IgnoreDamage 1
			}
		}
    }
}

VampireBabyBite {
    variant_of VampireBite
	
	target {
        multihit 98
	}
	
    temporary_effects {
		Fury 0
    }

    damage_instance {
        effects {
			Conditional_HasStatus {
				status Bleed
				Leech 1
			}
		}
    }
}
