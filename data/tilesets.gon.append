mansion {
    combat_background MansionBG
    combat_ui_background UI_Background_Mansion
    
    static_1x1_a BunkerObjects1 // using desert assets as placeholder, etc.
    static_1x1_b BunkerObjects2
    static_1x1_c SmallGravelPile
    
    static_2x2_a Bunker2x2
    static_2x2_b BigGravelPile
    
    static_tall_a BunkerTall1
    static_tall_b BunkerTall2
    
    debris Debris7

    event_piece_frame mansion

    global_objects {
        Lighting {
            bigrays [1, 1]
        }
    }

    reverb {
        battle {
            preset Cave
            amount .65
            volume_adjustment 1.50
            DecayTime 1.8
        }
    }
}