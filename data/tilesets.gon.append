mansion {
    combat_background MansionBG
    combat_ui_background UI_Background_Mansion
    
    static_1x1_a MansionObjects1
    static_1x1_b MansionObjects2
    static_1x1_c MansionObjects2
    
    static_2x2_a Mansion2x2
    static_2x2_b Mansion2x2
    
    static_tall_a MansionTall1
    static_tall_b MansionTall2
    
    debris MansionDebris

    event_piece_frame mansion

    global_objects {
        Lighting {
            bigrays [1, 1]
        }
    }

    reverb {
        battle {
            preset Cave
            amount .65
            volume_adjustment 1.50
            DecayTime 1.8
        }
    }
}