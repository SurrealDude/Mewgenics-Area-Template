graphics Map_Mansion
chapter_id mansion
tileset mansion
world_name_frame mansion
area_name AREA_NAME_MANSION
intro_cutscene mansion
act 1
chapter 2
version 1

levels {
    folder desert // <- currently using desert's levels, for demonstration purposes.
    easy [easy]
    hard [easy] //switch this to "hard" in the brackets if we get specific hard levels in!
    rare [rare]
    boss [boss]
    miniboss [miniboss]
    special [special]
}

music desert // <- currently using desert's music and ambience. feel free to change.
ambience amb_desert.ogg

events {
    normal [
        common
        desert_events.gon // <- using desert's events for demonstration.
    ]
}

enemy_pools { //for effects that need to spawn a "chapter enemy" of some sort
    small [RattleSnake] // <- etc.
    medium [FlySwarm SnakeyBones Carcus Peashy BabyDeathWorm HornyCat GunCat Mangy2 ScorpionCat]
    large [SkeletonShambler Thump DeathWorm]
}

item_pools {
    chapter_item_pool desertitems
}


bosses {
    zodiac auto
    gambit auto
}

minibosses {
    thiefcat auto
    clericcat auto
    butchercat auto
    necrocat auto
    jestercat auto
}

nodes {
    #include "standard_nodes.gon"

    //exits
    exit0 {
        type exit
        next_map bunker.gon
        locked true
        override_art MapNodeExit_Unknown // <- "Unknown" is being used as a placeholder for the next level.
    }

    //special
    boss {
        type boss
    }
}

flags {
    BunkerUnlocked { // flag that's currently locking the placeholder level. using bunker for demonstration purposes
        exit0 {
            locked false
        }
    }
}