LongLeg {
    graphics {
        movieclip LongLeg
        name "ENEMY_LONGLEG_NAME"
		tooltip "ENEMY_LONGLEG_DESC"
        shadow_size 1.2
    }

    stats {
        strength 5
        dexterity 5
        constitution 5
        intelligence 5
        speed 5
        charisma 5
        luck 5
    }
    
    properties {
        tag [humanoid leg]
        faction enemies
        health 16
        movement 2
        corpse_health 0
    }

    abilities {
		move LongLegStep
        attack LongLegKick

        spells [
			LongLegReady
			LongLegFall
        ]
    }

    passives {
		Trample 1
        Undead 1
		
		FormChanger {
            Alone {
				move LongLegRegroup
				/*passives {
					Trample 1
					AddHiddenTag leg
					DeathRattleRevive {
						ability LongLegFall
                        immediate true
                        even_if_stunned true
					}
				}*/
				ai {
					brain PatternBrain
			
					pattern {
						do_all [*attack *LongLegReady *move *attack *move]
					}
					fallback {
						do LongLegFall
					}
			
					decision_weights semi_simple
					move_weights stay_close
                    end_turn_on_formswitch true
				}
            }
            Ready {
                partial_animation_suffix Ready
				ai {
					brain PatternBrain
			
					pattern {
						do_all [*attack *move]
					}
			
					decision_weights semi_simple
					move_weights stay_close
				}
            }
            initial_form Alone
        }
    }
	
    ai {
        brain NoBrain
        decision_weights semi_simple
        move_weights stay_close
    }
}
