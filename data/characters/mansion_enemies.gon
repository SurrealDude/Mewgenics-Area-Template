VampireGuy {
    graphics {
        movieclip VampireGuy
        name "ENEMY_VAMPIREGUY_NAME"
		tooltip "ENEMY_VAMPIREGUY_DESC"
        uifloaters_offset 2
    }

    stats {
        strength 5
        dexterity 5
        constitution 5
        intelligence 5
        speed 5
        charisma 5
        luck 5
    }
    
    properties {
        tag humanoid
        faction enemies
        health 24
		initial_health 18
        mana 1
    }

    abilities {
        move DefaultMove
        attack VampireDagger
        
        spells [
			VampireBite
        ]
    }

    passives {
		Undead 1
    }
    
    ai {
        brain GenericBrain
        decision_weights default
        move_weights stay_close
    }
}
VampireGal {
    variant_of VampireGuy
	
	graphics {
        movieclip VampireGal
        name "ENEMY_VAMPIREGAL_NAME"
        desc "ENEMY_VAMPIREGAL_DESC"
    }
}
VampireBaby {
    graphics {
        movieclip Bat
        name "ENEMY_VAMPIREBABY_NAME"
        move_speed_multiplier 1.75
        uifloaters_offset 1.5
        scale .75
        default_attack_animation attack2
		
		tooltip "ENEMY_VAMPIREBABY_DESC"
    }

    stats {
        strength 1
        dexterity 5
        constitution 5
        intelligence 5
        speed 2
        charisma 5
        luck 6
    }
    
    properties {
        tag humanoid
        faction enemies
        health 24
		initial_health 12
    }

    abilities {
        move DefaultMove
        attack VampireBabyBite
        
        spells [
			VampireBabyTransform
			
			BabyBatTransform
        ]
    }

    passives {
		Undead 1
        FormChanger {
            Baby {

                ai {
                    brain PatternBrain
					
                    pattern {
						do_all [move attack *VampireBabyTransform]
                    }

                    end_turn_on_formswitch true
                    decision_weights default
                    move_weights stay_close
                }
            }
            Bat {
                //animation_suffix Bat
                name "ENEMY_BABYBAT_NAME"
				tooltip "ENEMY_BABYBAT_DESC"
				attack BabyBatFlurry
				
				properties {
					flying true
				}
				
				passives {
					DodgeChance 50%
				}

                ai {
                    brain PatternBrain
					
                    pattern {
                        do_all [attack move *BabyBatTransform]
                    }

                    end_turn_on_formswitch true
                    decision_weights default
                    move_weights keep_distance_always_move
                }
            }

            initial_form Baby
        }
    }
    
    ai {
        brain NoBrain
    }
}
